DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://platform:platform@shared-postgres:5432/platform

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# JWT (access + refresh). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -- asaas_payment (mTLS) --
# ASAAS_PAYMENT_BASE_URL points at asaas_payment's nginx (mTLS termination),
# which joins `devbutter_shared` as `asaas-nginx` in local development.
# Generate the client cert with:
#   asaas_payment/scripts/generate_dev_certs.sh devbutter-platform
# then add "devbutter-platform" to asaas_payment's ALLOWED_CLIENT_CNS.
ASAAS_PAYMENT_BASE_URL=https://asaas-nginx:8443
ASAAS_CLIENT_CERT_PATH=/app/certs/devbutter-platform.crt
ASAAS_CLIENT_KEY_PATH=/app/certs/devbutter-platform.key
ASAAS_CA_CERT_PATH=/app/certs/ca.crt
ASAAS_REQUEST_TIMEOUT_SECONDS=15

# Shared secret Asaas sends back on every webhook call, configured in the
# Asaas dashboard. See https://docs.asaas.com/docs/duvidas-frequentes-webhooks
ASAAS_WEBHOOK_ACCESS_TOKEN=

# -- butter_mind (plain HTTP, same Docker network) --
BUTTER_MIND_BASE_URL=http://mind-api:8000
BUTTER_MIND_REQUEST_TIMEOUT_SECONDS=30
# Must match butter_mind INTERNAL_API_KEY. Used only server-to-server for /admin/mind.
BUTTER_MIND_INTERNAL_API_KEY=

# -- butter_relay (boto3 SQS / local ElasticMQ) --
AWS_REGION=us-east-1
RELAY_SQS_QUEUE_URL=http://elasticmq:9324/000000000000/relay-shared
RELAY_SQS_ENDPOINT_URL=http://elasticmq:9324
# The Project.id registered in the butter_relay admin for "devbutter-platform".
RELAY_PROJECT_ID=
