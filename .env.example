DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# Hostnames below resolve on the Docker network (scripts/dev-up.sh / compose).
# Settings assembles postgresql+asyncpg:// from these parts. DATABASE_URL is ignored.
DATABASE_HOST=shared-postgres
DATABASE_PORT=5432
DATABASE_USER=platform
DATABASE_PASSWORD=platform
DATABASE_NAME=platform

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# JWT (access + refresh). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -- asaas_payment (mTLS) --
# ASAAS_PAYMENT_BASE_URL points at asaas_payment's nginx (mTLS termination),
# which joins `devbutter_shared` as `asaas-nginx` in local development.
# Generate the client cert with:
#   asaas_payment/scripts/generate_dev_certs.sh devbutter-platform
# then add "devbutter-platform" to asaas_payment's ALLOWED_CLIENT_CNS.
ASAAS_PAYMENT_BASE_URL=https://asaas-nginx:8443
ASAAS_CLIENT_CERT_PATH=/app/certs/devbutter-platform.crt
ASAAS_CLIENT_KEY_PATH=/app/certs/devbutter-platform.key
ASAAS_CA_CERT_PATH=/app/certs/ca.crt
ASAAS_REQUEST_TIMEOUT_SECONDS=15
# Card tokenization/payment waits for the provider's recommended 60-second window.
ASAAS_CARD_REQUEST_TIMEOUT_SECONDS=70

# Browser transport keyring: kid:base64url-encoded-32-byte-key. This key is not authentication.
PAYMENT_PAYLOAD_KEYRING=
# Fernet key for the token returned by Asaas; never reuse FIELD_ENCRYPTION_KEY implicitly.
PAYMENT_TOKEN_ENCRYPTION_KEY=
PAYMENT_TOKEN_ENCRYPTION_KID=payment-token-v1
PAYMENT_CONTEXT_TTL_SECONDS=300

# Shared secret Asaas sends back on every webhook call, configured in the
# Asaas dashboard. See https://docs.asaas.com/docs/duvidas-frequentes-webhooks
ASAAS_WEBHOOK_ACCESS_TOKEN=

# Publicly reachable base URL of THIS backend (no trailing slash). Used to
# register the subaccount's ACCOUNT_STATUS_* webhook on Asaas when a subaccount
# is provisioned. Subaccount provisioning refuses to run while this is empty.
BACKEND_PUBLIC_BASE_URL=
# Optional: address Asaas notifies about webhook delivery problems.
ASAAS_WEBHOOK_OPS_EMAIL=

# -- butter_mind (plain HTTP, same Docker network) --
BUTTER_MIND_BASE_URL=http://mind-api:8000
BUTTER_MIND_REQUEST_TIMEOUT_SECONDS=30
# Must match butter_mind INTERNAL_API_KEY. Used only server-to-server for /admin/mind.
BUTTER_MIND_INTERNAL_API_KEY=local-dev-mind-internal
# Must match butter_mind SERVICE_API_KEY. Used server-to-server for the public
# diagnosis/chat endpoints devbutter_backend calls on behalf of site visitors.
BUTTER_MIND_SERVICE_API_KEY=local-dev-mind-service

# -- butter_blob (plain HTTP, same Docker network) --
BUTTER_BLOB_BASE_URL=http://blob-api:8000
BUTTER_BLOB_REQUEST_TIMEOUT_SECONDS=30
# Must match a SERVICE_API_KEY butter_blob accepts. Every blob this backend
# creates is bound to BUTTER_BLOB_NAMESPACE.
BUTTER_BLOB_SERVICE_API_KEY=
BUTTER_BLOB_NAMESPACE=devbutter_backend

# -- butter_relay (Celery task, same Redis broker relay's own worker consumes from) --
REDIS_URL=redis://redis:6379/0
RELAY_QUEUE_NAME=relay-shared
# The Project.id (UUID) registered in the butter_relay admin for the platform.
# Must NOT be empty: an empty id makes the relay drop every message and breaks
# quote/account notifications (DVB-332). Local stack lookup:
#   docker exec infra-shared-postgres-1 psql -U devbutter_admin -d relay \
#     -Atc "select id, name from projects;"
# Publish the default templates for that Project with:
#   cd ../butter_relay && poetry run python scripts/seed_devbutter_templates.py <project-uuid>
RELAY_PROJECT_ID=

# NFS-e emission (originator). Leave ASAAS_NFSE_SUBACCOUNT_ID empty to skip.
# Municipal service: use ID when GET fiscal-info/services returns a list; otherwise CODE.
ASAAS_NFSE_SUBACCOUNT_ID=
ASAAS_NFSE_MUNICIPAL_SERVICE_ID=
ASAAS_NFSE_MUNICIPAL_SERVICE_CODE=
ASAAS_NFSE_MUNICIPAL_SERVICE_NAME=
ASAAS_NFSE_SERVICE_DESCRIPTION=Serviços de desenvolvimento de software

# butter_blob — use a bbk_ namespace key when available. Namespace nfse is shared
# with butter_relay so the worker can resolve blob_id without a private URL in SQS.
# Reuses BUTTER_BLOB_BASE_URL above -- same underlying service.
# Must match butter_blob SERVICE_API_KEY (legacy X-Service-Api-Key).
BUTTER_BLOB_API_KEY=change-me-in-production
NFSE_BLOB_NAMESPACE=nfse
BUTTER_BLOB_TIMEOUT_SECONDS=30
NFSE_EMAIL_LOGO_URL=https://devbutter.com/logo.png

# -- selolibertaria/backend (same Docker network) --
# HMAC must match DEVBUTTER_SELOLIBERTARIA_RELAY_HMAC_SECRET on the Selo API.
SELOLIBERTARIA_BACKEND_BASE_URL=http://selolibertaria-backend:8000
DEVBUTTER_SELOLIBERTARIA_RELAY_HMAC_SECRET=local-dev-selo-relay-hmac
SELOLIBERTARIA_RELAY_REQUEST_TIMEOUT_SECONDS=10
