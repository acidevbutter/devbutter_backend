flowchart LR
    Client[Frontend / cliente]
    Admin[Portal admin]
    API[DevButter Backend - FastAPI]
    DB[(PostgreSQL)]
    Mind[butter_mind - HTTP / SSE]
    Relay[butter_relay - e-mail / SQS]
    Asaas[Asaas]
    AsaasClient[asaas_payment - mTLS]
    Socket[Socket.IO / ASGI]

    Client -->|JWT / HTTP| API
    Client -->|httpOnly cookie| Socket
    Admin -->|JWT admin / HTTP| API
    Socket --> API
    API --> DB
    API --> Mind
    API --> Relay
    API --> AsaasClient
    AsaasClient --> Asaas
    Asaas -->|asaas-access-token| API

    subgraph Meta["Meta e saude"]
        H1["GET /health"]
        H2["GET /health/ready"]
    end
    API --> Meta

